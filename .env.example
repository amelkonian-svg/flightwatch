# Copy this file to ".env" and fill in your own Pushover keys.
# Get both from https://pushover.net (create an Application/API Token for the app token).
# This file is read locally by flightwatch.js — your keys never leave your Mac.

PUSHOVER_TOKEN=your_pushover_app_api_token_here
PUSHOVER_USER=your_pushover_user_key_here
